# Application
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM Provider
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
VECTOR_INDEX_PATH=vector_store/index.faiss
STANDARDS_DATA_PATH=data/standards/standards.json
RELATIONSHIPS_DATA_PATH=data/relationships/relationships.json
QCO_DATA_PATH=data/compliance/qco.json

# Limits
MAX_FILE_SIZE_MB=20
OCR_MIN_TEXT_LENGTH=50
